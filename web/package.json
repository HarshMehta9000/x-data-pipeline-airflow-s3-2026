{
  "name": "x-pipeline-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gate": "node gates/run-all.mjs",
    "verify": "npm run typecheck && npm run lint && npm run gate",
    "mutate": "node gates/mutation.mjs",
    "media": "node media/gif.mjs && node media/card.mjs",
    "media:frames": "XDP_FRAMES=media/frames node media/gif.mjs && XDP_FRAMES=media/frames node media/card.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "gifenc": "^1.0.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
